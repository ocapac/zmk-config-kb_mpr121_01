#include "kb_mpr121_01.dtsi"

/ {

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    &i2c1 {
    status = "okay";
    sda-gpios = <&gpio0 17 (GPIO_PULL_UP)>;
    scl-gpios = <&gpio0 20 (GPIO_PULL_UP)>;
    clock-frequency = <I2C_BITRATE_FAST>;

    mpr121: mpr121@5a {
        compatible = "freescale,mpr121";
        reg = <0x5a>;
        int-gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        status = "okay";
        electrode-count = <8>;
        enable-proximity;
        touch-threshold = <0x08>;
        release-threshold = <0x05>;
        prox-touch-threshold = <0x06>;
        prox-release-threshold = <0x04>;
        filter-configuration = <0x20>; /* ESI=1ms */
    };
};

};

&physical_layout_kb_mpr121_01 {
    kscan = <&kscan0>;
};

